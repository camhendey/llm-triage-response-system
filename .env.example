# Copy to .env and fill in only what you need. Never commit .env. Keys are never displayed or logged.
# Interpreter: offline (default, deterministic pattern rules) or live (Anthropic Messages API).
RW_PROVIDER=offline
ANTHROPIC_API_KEY=
# Live-model settings (used only when RW_PROVIDER=live). Check the current model list before changing.
RW_MODEL=claude-opus-5-5
RW_EFFORT=medium
RW_TIMEOUT_SECONDS=60
RW_SDK_MAX_RETRIES=2
RW_MAX_ATTEMPTS=2
RW_REFUSAL_FALLBACK=on
# Optional database locations (defaults under data/).
RW_DEMO_DB=
RW_SESSION_DB=
RW_STUDY_DB=
